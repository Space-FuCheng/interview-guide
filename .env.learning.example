# Run .\dev.cmd init to generate the local .env from this template.
# Secret placeholders are replaced locally; this template contains no credentials.
AI_BAILIAN_API_KEY=
AI_MODEL=qwen3.5-flash
APP_AI_CONFIG_ENCRYPTION_KEY=__ENCRYPTION_KEY__
APP_AI_CONFIG_YAML_PATH="__CONFIG_DIR__/llm-providers.yml"
APP_AI_CONFIG_ENV_PATH="__CONFIG_DIR__/llm-providers.env"

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

APP_STORAGE_ENDPOINT=http://127.0.0.1:19000
APP_STORAGE_ACCESS_KEY=learningadmin
APP_STORAGE_SECRET_KEY=__STORAGE_SECRET__
APP_STORAGE_BUCKET=interview-guide
RUSTFS_RPC_SECRET=__RPC_SECRET__

SERVER_PORT=18080
SERVER_ADDRESS=127.0.0.1
APP_VOICE_OPENING_AUDIO_WARMUP_ENABLED=false
